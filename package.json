{
  "name": "project-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/architecture.test.mjs tests/geometry.test.mjs tests/combat.test.mjs",
    "test:pressure": "node --experimental-strip-types --test tests/pressure.test.mjs",
    "test:battle": "node --experimental-strip-types --test tests/battle.test.mjs",
    "test:mechanism": "node --experimental-strip-types --test tests/mechanism.test.mjs",
    "test:audio": "node --experimental-strip-types --test tests/audio.test.mjs",
    "test:release": "node --experimental-strip-types --test tests/release.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run test:pressure && npm run test:battle && npm run test:mechanism && npm run test:audio && npm run test:release && npm run typecheck",
    "build": "npm run check && vite build --emptyOutDir false",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify-battle.mjs",
    "check:build": "node scripts/check-build.mjs",
    "bench:gpu": "bash scripts/gpu-benchmark.sh",
    "preview": "vite preview --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
