{
  "name": "project-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:single": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "build": "npm run check && vite build",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify-battle.mjs",
    "verify:editor": "node scripts/verify-editor.mjs",
    "verify:appearance": "node --experimental-strip-types scripts/verify-appearance.mjs",
    "verify:iso": "node --experimental-strip-types scripts/verify-iso.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:clock": "node scripts/verify-clock.mjs",
    "verify:music": "node scripts/verify-music.mjs",
    "check:build": "node scripts/check-build.mjs",
    "bench:gpu": "node scripts/gpu-benchmark.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
